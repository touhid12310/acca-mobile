{
  "expo": {
    "name": "AccountE",
    "slug": "accounte-expo",
    "version": "1.8.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "accounte",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.accounte.finance",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Allow AccountE to access your microphone for voice transcription.",
        "NSCameraUsageDescription": "AccountE needs access to your camera to capture receipts.",
        "NSPhotoLibraryUsageDescription": "AccountE needs access to your photos to upload receipts.",
        "NSSpeechRecognitionUsageDescription": "Allow AccountE to use speech recognition for live transcription.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "remote-notification"
        ],
        "UIRequiresFullScreen": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "com.googleusercontent.apps.799451467900-8t35fi6ope0c7nfbsnla38c660icadpv"
            ]
          }
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.accounte.finance",
      "googleServicesFile": "./google-services.json",
      "softwareKeyboardLayoutMode": "pan",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-dev-client",
      "expo-secure-store",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#3b82f6",
          "defaultChannel": "default"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "AccountE needs access to your camera to capture receipts.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow AccountE to access your microphone for voice recording."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AccountE to access your photos to upload receipts.",
          "cameraPermission": "Allow AccountE to access your camera to capture receipts."
        }
      ],
      "expo-font",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "image": "./assets/logo-dark.png",
            "backgroundColor": "#0b1830"
          }
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow AccountE to access your microphone for voice transcription.",
          "speechRecognitionPermission": "Allow AccountE to use speech recognition for live transcription."
        }
      ],
      "expo-web-browser",
      "./plugins/withoutMediaPlaybackForegroundService",
      "expo-iap",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true,
            "extraProguardRules": "-keep class com.accounte.finance.** { *; }\n-keepattributes SourceFile,LineNumberTable\n-keepattributes *Annotation*,Signature,Exceptions\n-keep class com.facebook.hermes.unicode.** { *; }\n-keep class com.facebook.jni.** { *; }"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "dbbbcf0f-926a-4e11-afc1-f2f4552a71a8"
      }
    },
    "owner": "touhid12310"
  }
}
